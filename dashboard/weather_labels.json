        },
        {
          "pattern": "^[-+]?SH\\w*RA",
          "key": "showers"
        },
        {
          "pattern": "^\\+SN",
          "key": "heavy_snow"
        },
        {
          "pattern": "^-(SN|SG)|^SG",
          "key": "light_snow"
        },
        {
          "pattern": "^SN",
          "key": "snow"
        },
        {
          "pattern": "^\\+RA",
          "key": "heavy_rain"
        },
        {
          "pattern": "^-RA",
          "key": "light_rain"
        },
        {
          "pattern": "^RA",
          "key": "rain"
        },
        {
          "pattern": "^[-+]?DZ",
          "key": "drizzle"
        },
        {
          "pattern": "^(MI|BC|PR)?FG",
          "key": "fog"
        },
        {
          "pattern": "^BR",
          "key": "mist"
        },
        {
          "pattern": "^HZ",
          "key": "haze"
        },
        {
          "pattern": "^FU",
          "key": "smoke"
        },
        {
          "pattern": "^(BL|DR)?DU",
          "key": "dust"
        },
        {
          "pattern": "^(BL|DR)?SA",
          "key": "sand"
        },
        {
          "pattern": "^VA",
          "key": "volcanic_ash"
        },
        {
          "pattern": "^[-+]?DS",
          "key": "duststorm"
        },
        {
          "pattern": "^[-+]?SS",
          "key": "sandstorm"
        },
        {
          "pattern": "^SQ",
          "key": "squalls"
        },
        {
          "pattern": "^\\+?FC",
          "key": "tornado"
        },
        {
          "pattern": "^IC",
          "key": "ice_crystals"
        },
        {
          "pattern": "^[-+]?UP",
          "key": "unknown_precipitation"
        }
      ],
      "cloudCover": {
        "CAVOK": "no_significant_cloud",
        "SKC": "clear",
        "CLR": "clear",
        "NSC": "no_significant_cloud",
        "NCD": "no_significant_cloud",
