    "metar": {
      "ignorePrefixes": [
        "VC",
        "RE"
      ],
      "ignoreTokens": [
        "NSW"
      ],
      "weatherRules": [
        {
          "pattern": "^[-+]?TS\\w*(GR|GS)",
          "key": "thunderstorm_hail"
        },
        {
          "pattern": "^[-+]?TS\\w*(RASN|SNRA|PL)",
          "key": "thunderstorm_mixed"
        },
        {
          "pattern": "^[-+]?TS\\w*SN",
          "key": "thunderstorm_snow"
