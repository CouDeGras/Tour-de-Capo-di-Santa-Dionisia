__pycache__/
*.pyc
.claude/settings.local.json

# SQLite db -- Django's own bookkeeping (auth/sessions/admin) plus
# dashboard.models' IrrigationDecision/MetarReading. Runtime state, not
# source; data/*.json below is the other runtime-generated store.
db.sqlite3

# runtime-generated cache/data files
data/*
!data/.gitkeep
!data/site_config.json

# electron/: node deps, staged backend copy + venv, and build output are
# all reproducible from source (npm install / build-backend.sh / npm run
# build) -- none of it belongs in the repo.
electron/node_modules/
electron/resources/
electron/dist/
electron/.build-cache/
