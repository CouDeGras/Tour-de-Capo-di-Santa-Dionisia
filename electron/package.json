{
  "name": "capo-di-santa-dionisia",
  "productName": "Capo di Santa Dionisia",
  "version": "1.0.0",
  "description": "Irrigation dashboard and weather/MQTT service, bundled as a self-contained desktop app.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "stage": "bash build-backend.sh",
    "stage:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build-backend-win.ps1",
    "start": "electron .",
    "build": "bash build-linux.sh",
    "build:linux": "npm run build",
    "build:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build-win.ps1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.capo-di-santa-dionisia.dashboard",
    "productName": "Capo di Santa Dionisia",
    "artifactName": "${name}-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      "build/icon.ico"
    ],
    "extraResources": [
      { "from": "resources/app", "to": "app" },
      { "from": "resources/venv", "to": "venv" }
    ],
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${name}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "afterPack": "afterPack.js"
  }
}
